amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

exclude = List("pnpm-lock.yaml")

local linters = new Mapping {
    ["ox_lint"] = (Builtins.ox_lint) {
        prefix = List("pnpm", "exec")
    }
    ["oxfmt"] = (Builtins.oxfmt) {
        prefix = List("pnpm", "exec")
    }
    ["tsc"] = (Builtins.tsc) {
        check = "pnpm exec tsc --noEmit -p {{workspace_indicator}}"
    }
    ["just_format"] = (Builtins.just_format) {
        // The builtin runs `xargs -d`, which macOS xargs lacks, and has no check.
        // `-I` alone already passes one file per line.
        check = "xargs -I {} -- just --fmt --check --unstable --justfile {}"
        fix = "xargs -I {} -- just --fmt --unstable --justfile {}"
        tests {
            ["check rejects unformatted justfile"] {
                run = "check"
                files = List("{{tmp}}/justfile")
                write { ["{{tmp}}/justfile"] = "tmp:\n        echo tmp\n" }
                expect { code = 1 }
            }
            ["fix formats justfile"] {
                run = "fix"
                files = List("{{tmp}}/justfile")
                write { ["{{tmp}}/justfile"] = "tmp:\n        echo tmp\n" }
                expect { files { ["{{tmp}}/justfile"] = "tmp:\n    echo tmp\n" } }
            }
        }
    }
    ["jscpd"] = new Step {
        glob = List("**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}")
        // A clone spans files, so scan the whole project, not just changed files.
        check = "pnpm exec jscpd ."
    }
    ["knip"] = (Builtins.knip) {
        check = "pnpm exec knip --no-progress --directory {{workspace}}"
        // The builtin fix deletes unused exports and dependencies on commit,
        // which breaks work in progress. Report them for review instead.
        fix = null
    }
}

steps = linters

hooks {
    ["pre-commit"] {
        steps = (linters) {
            // Scans only what is being committed, unlike the default whole-tree scan.
            ["gitleaks"] = (Builtins.gitleaks) {
                scan = "staged"
            }
            ["jev-lint"] {
                glob = List("**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}")
                // hk stashes unstaged changes first, so the files on disk match the index.
                // Findings are candidates for the agent to review, so it never fails.
                check = "fnox exec -- pnpm jev-lint --staged"
                output_summary = "stdout"
            }
        }
    }
    ["commit-msg"] {
        steps {
            ["commitlint"] {
                check = "pnpm exec commitlint --edit {{commit_msg_file}}"
            }
        }
    }
}
